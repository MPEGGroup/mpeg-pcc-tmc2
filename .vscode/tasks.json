{
    "version": "2.0.0",
    "_runner": "terminal",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "bash",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "args": [
                "-c",
                "./build.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "format",
            "type": "shell",
            "command": "bash",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "args": [
                "-c",
                "./build.sh format"
            ],
            "group": {
                "kind": "format",
                "isDefault": false
            }
        },
        {
            "label": "clear",
            "type": "shell",
            "command": "bash",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "args": [
                "-c",
                "./clear.sh"
            ],
            "group": {
                "kind": "clear",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "/usr/local/opt/llvm/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}